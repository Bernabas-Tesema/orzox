{
  "framework": null,
  "installCommand": "cd frontend1 && npm install",
  "buildCommand": "cd frontend1 && npm run build:web",
  "outputDirectory": "frontend1/dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://orzox-1.onrender.com/api/v1/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://orzox-1.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
