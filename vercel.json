{
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "frontend1/dist",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "$RENDER_BACKEND_URL/api/v1/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "$RENDER_BACKEND_URL/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
